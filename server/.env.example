NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATA_DIR=server/data
CORS_ORIGINS=https://zev668.github.io
# WeChat Open Platform *mobile application* (open.weixin.qq.com → 管理中心 → 移动应用).
# Package com.yukomon.app; signature = MD5 of the release keystore cert (lowercase, no colons).
# The same AppID must be exported as YUKOMON_WECHAT_APP_ID when building the APK.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
FFPROBE_PATH=ffprobe
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
TENCENT_MAP_BROWSER_KEY=
TENCENT_MAP_SERVER_KEY=
TENCENT_MAP_SECRET=
